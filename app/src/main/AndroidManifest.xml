<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "Delete App" in edit mode (system uninstall dialog) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Bug report screen recording (Settings › Advanced › Report a Problem): foreground service + its notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- App list via LauncherApps; package visibility for all launcher activities -->
    <queries>
        <!-- Mail apps for the bug report by email -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Detect the Magisk app (welcome: root step) -->
        <package android:name="com.topjohnwu.magisk" />
        <!-- Make the system launcher (gesture navigation/QuickStep) visible: GestureNavContract reply -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Find icon packs (ADW/Nova format) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.fede.launcher.THEME_ICONPACK" /></intent>
        <intent><action android:name="ch.deletescape.lawnchair.ICONPACK" /></intent>
        <intent><action android:name="app.lawnchair.icons.THEMED_ICON" /></intent>
    </queries>

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- own status bar: Wi-Fi signal of the active network -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Weather widget: Open-Meteo + coarse location -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Search: find contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- App suggestions: usage statistics (special access, the user allows it in the settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Granted only with the Animation Module (system app): own open animation. Without the module it has no effect. -->
    <uses-permission android:name="android.permission.CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="Liquidy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.IosHome"
        android:supportsRtl="false">
        <!-- Release builds can be CPU-profiled with simpleperf from adb (performance work on real phones); no other effect -->
        <profileable android:shell="true" />

        <!-- Modelled on Launcher3: singleTask + stateNotNeeded + HOME/DEFAULT -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Notification counter for the red badges (the user grants access in the settings) -->
        <service
            android:name=".data.NotificationBadges"
            android:exported="true"
            android:label="Liquidy"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Bug report screen recording + the invisible step that opens the GitHub issue after stopping -->
        <service
            android:name=".data.BugRecorder"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".data.BugReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
