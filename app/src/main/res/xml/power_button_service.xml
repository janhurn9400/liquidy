<?xml version="1.0" encoding="utf-8"?>
<!-- Power menu + Duo status symbols over apps: only window-change events (package name), no window content, no
     gestures; screenshots only to measure the brightness behind the symbols. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/power_service_description"
    android:summary="@string/power_service_summary"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:notificationTimeout="0" />
