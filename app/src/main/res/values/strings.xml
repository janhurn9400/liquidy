    <string name="settings_diagnostics_copied">Copied</string>
    <string name="settings_diagnostics_footer">Technical details only — no apps or personal data. Nothing is sent until you submit the issue on GitHub.</string>
    <string name="settings_report">Report a Problem</string>
    <string name="settings_report_about">Found a bug or something that looks different from the original? Open an issue on GitHub — the technical details below are filled in for you, just describe what happened.</string>
