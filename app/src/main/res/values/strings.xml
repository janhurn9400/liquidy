    <string name="settings_report_included">Included Details</string>
    <string name="settings_report_template">**What happened?**\n\n\n**What did you expect?**\n\n\n**Steps to reproduce**\n1. \n\n**Device details** (filled in by Liquidy)</string>
    <string name="settings_sec_module">Animation Module</string>
    <string name="settings_module">Animation Module</string>
    <string name="settings_module_footer">Optional, needs root (Magisk). Without the module Android uses its standard animation. It changes nothing else and sends nothing; its contents are open on GitHub.</string>
    <string name="settings_module_missing">Not installed</string>
    <string name="settings_module_about">Lets the launcher use its own animations when you open and close apps. Android only allows this for system apps, so this small module adds the installed Liquidy app as one.</string>
