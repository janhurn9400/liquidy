    <string name="settings_cat_quirks">🍎 Quirks</string>
    <string name="settings_quirks_intro">By default the launcher behaves exactly like the original, quirks included. Here you can relax individual quirks — every option here is not like the original.</string>
    <string name="settings_sec_grid">Grid</string>
    <string name="settings_free_widget_rows">Widgets in Any Row</string>
    <string name="settings_free_widget_rows_footer">Normally 2-row widgets only snap into row pairs (rows 1, 3 and 5), so there is never a single row of apps above a widget. Turn on to place them in any row.</string>
    <string name="settings_sec_glass">Liquid Glass</string>
    <string name="settings_glass_footer">Clear is more transparent and shows the refraction; tinted is frosted and more opaque, adding contrast to content and controls.</string>
