<?xml version="1.0" encoding="utf-8"?>
<!-- Allows the Liquidy launcher its own open animation (remote animation on app launch). -->
<permissions>
    <privapp-permissions package="io.github.janhurn9400.liquidy">
        <permission name="android.permission.CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS"/>
    </privapp-permissions>
</permissions>
